          <a id="next-page" class="page-btn page-nav" href="/category?page=<%= currentPage + 1%><%= searchValue ? '&search=' + encodeURIComponent(searchValue) : '' %>">
            <span class="material-symbols-outlined">chevron_right</span>
          </a>
          <% } else { %>
          <span id="next-page" class="page-btn page-nav disabled"> <span class="material-symbols-outlined">chevron_right</span> </span> <% } %>
        </nav>
 
      </div>
    </div>
  </section>
 
