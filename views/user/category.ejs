          </a>
          <% }else{ %>
              <a class="page-btn page-nav disabled" id="prev-page" href="/category?page=<%= currentPage %>">
              <span class="material-symbols-outlined">chevron_left</span> 
          </a>
           <% } %>

          <!-- PAGE NUMBER BUTTONS -->
          <div class="page-numbers" id="page-numbers">
            <% for( let i = 1 ; i <=   totalPage ; i++ ) { %>
            <a id="next-page" class="page-btn page-num <%= currentPage === i ? 'active' : '' %>" href="/category?page=<%= i %><%= searchValue ? '&search=' + encodeURIComponent(searchValue) : '' %>"><%= i %></a>
