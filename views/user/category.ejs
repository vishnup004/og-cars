        <!-- PAGINATION LEFT BUTTON -->
        <nav class="pagination" aria-label="Product pagination">
          <% if (currentPage > 1) { %>
          <a class="page-btn page-nav" id="prev-page" href="/category?page=<%= currentPage - 1 %><%= searchValue ? '&search=' + encodeURIComponent(searchValue) : '' %>">
