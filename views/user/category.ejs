        <span class="material-symbols-outlined">
          chevron_right
        </span>

        <a href="/category">CATEGORIES & PRODUCTS</a>

      </div>

      <h1 class="cat-page-title">
        ALL <span class="accent">PRODUCTS</span>
      </h1>

    </div>
  </section>
 
