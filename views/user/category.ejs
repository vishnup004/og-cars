<body>
    
<!-- TopNavBar -->
<nav class="navbar">
  <div class="navbar-inner">
    <div class="brand">OG_CARS</div>
    <div class="nav-links">
      <a class="nav-link" href="/home">Shop</a>
      <a class="nav-link active" href="/category">Category</a>
      <a class="nav-link" href="#">About</a>
      <a class="nav-link" href="#">Faq</a>
    </div>
    <div class="nav-actions">
      <div class="icon-buttons">
        <button class="icon-btn" aria-label="Search">
          <span class="material-symbols-outlined">search</span>
        </button>
        <a href="/user/wishlist" class="icon-btn" aria-label="Wishlist">
          <span class="material-symbols-outlined">favorite_border</span>
        </a>
        <a href="/mainCart" class="icon-btn icon-btn-cart" aria-label="Cart">
          <span class="material-symbols-outlined">shopping_cart</span>
          <span class="cart-dot"></span>
        </a>
        <a href="/profile" class="icon-btn" aria-label="Account" class="profileBt" id="profile-button">
          <span class="material-symbols-outlined">person</span>
        </a>
        <button class="icon-btn menu-btn" aria-label="Menu">
          <span class="material-symbols-outlined">menu</span>
        </button>
      </div>
    </div>
  </div>
</nav>
 
<main class="main-content">
 
