<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/user/changePassword.css">
    <title>Change Password</title>
</head>
<body>
    <div class="dashboard">
 
  <!-- ===== SIDEBAR ===== -->
  <aside class="sidebar">
    <a href="/home" class="back-link">
      <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      BACK TO DASHBOARD
    </a>
 
    <nav class="side-nav">
      <a href="/profile" class="nav-item" data-panel="profile">
        <span class="nav-bar"></span>
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
        USER PROFILE
      </a>
      <a href="#" class="nav-item active" data-panel="password">
        <span class="nav-bar"></span>
        <svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="M10.5 12.5L20 3M20 3v5M20 3h-5"/></svg>
        CHANGE PASSWORD
      </a>
      <a href="/address" class="nav-item" data-panel="address">
        <span class="nav-bar"></span>
        <svg viewBox="0 0 24 24"><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        USER ADDRESS
      </a>
      <a href="#" class="nav-item" data-panel="orders">
        <span class="nav-bar"></span>
        <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
        VIEW ORDERS
      </a>
      <a href="#" class="nav-item" data-panel="watchlist">
        <span class="nav-bar nav-bar-pink"></span>
        <svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.9-10-9.3C.4 8.3 2 4.5 5.7 4c2-.3 3.9.7 6.3 3.2C14.4 4.7 16.3 3.7 18.3 4c3.7.5 5.3 4.3 3.7 7.7C19.5 16.1 12 21 12 21z"/></svg>
        WATCHLIST
      </a>
      <a href="#" class="nav-item" data-panel="wallet">
        <svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="14" rx="2"/><path d="M2 10h20M17 15h1"/></svg>
        WALLET
      </a>
      <a href="#" class="nav-item" data-panel="logout" id="logoutBtn">
        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
        LOGOUT
      </a>
    </nav>
  </aside>
 
  <!-- ===== MAIN PANEL ===== -->
  <main class="panel">  
    <h1 class="panel-title">CHANGE PASSWORD</h1>
    <div class="panel-divider"></div>
 
    <!-- Success message placeholder: show this block when there's a success message -->
    <div class="success-msg" id="successMsg" hidden></div>
 
    <!-- Error message placeholder: show this block when there's an error message -->
    <div class="error-msg" id="errorMsg" hidden></div>
 
    <form class="profile-form" id="passwordForm" action="/change-password" method="POST" novalidate>
 
      <!-- Current Password -->
      <div class="field-row single">
        <div class="field-group">
          <label for="currentPassword">SECURITY CHECK: CURRENT PASSWORD</label>
          <div class="locked-input password-field">
            <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter current password" autocomplete="current-password" required>
            <button type="button" class="toggle-visibility" data-target="currentPassword" aria-label="Show password">
              <svg viewBox="0 0 24 24"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <a href="/change-password/forgot-password" class="forgot-password-link">Forgot Password?</a>
        </div>
      </div>
 
      <!-- New Password -->
      <div class="field-row single">
        <div class="field-group">
          <label for="newPassword">ACCESS UPDATE: NEW PASSWORD</label>
          <div class="locked-input password-field">
            <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password" autocomplete="new-password" required minlength="8">
            <button type="button" class="toggle-visibility" data-target="newPassword" aria-label="Show password">
              <svg viewBox="0 0 24 24"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
      </div>
 
      <!-- Confirm Password -->
      <div class="field-row single">
        <div class="field-group">
          <label for="confirmPassword">VERIFY UPDATE: CONFIRM NEW PASSWORD</label>
          <div class="locked-input password-field">
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter new password" autocomplete="new-password" required minlength="8">
            <button type="button" class="toggle-visibility" data-target="confirmPassword" aria-label="Show password">
              <svg viewBox="0 0 24 24"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <p class="field-hint" id="passwordHint">Use at least 8 characters.</p>
        </div>
      </div>
 
      <p class="modal-error" id="passwordFormError"></p>
 
      <div class="form-footer">
        <button type="submit" class="btn-save" id="passwordSaveBtn">UPDATE PASSWORD</button>
      </div>
 
    </form>
  </main>
 
</div>
 
<!-- =========================================================
     LOGOUT CONFIRM MODAL
========================================================== -->
 
<div class="modal-overlay" id="logoutModalOverlay">
    <div class="modal-box modal-danger" role="dialog" aria-modal="true" aria-labelledby="logoutModalTitle">
        <div class="modal-header">
            <h2 id="logoutModalTitle">LOGOUT</h2>
            <button type="button" class="modal-close" id="logoutModalCloseBtn" aria-label="Close">
                <svg viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
        </div>
        <p class="modal-danger-text">
            Are you sure you want to logout from your account?
        </p>
        <form id="logoutForm" action="/logout" method="POST">
            <div class="modal-actions">
                <button type="button" class="btn-cancel" id="logoutModalCancelBtn">CANCEL</button>
                <button type="submit" class="btn-save btn-delete-confirm">LOGOUT</button>
            </div>
        </form>
    </div>
</div>

<% if (typeof message !== 'undefined' && message) { %>

    <div id="toast" class="toast <%= success ? 'success' : 'error' %>">
        <span class="toast-icon">
          <%= success ? "✓" : "✕"%>
        </span>
        <span id="toastMessage"><%= message %></span>
    </div>

<% } %>

<script src="/js/user/changePassword.js"></script>
</body>
</html>