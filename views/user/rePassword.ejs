<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/user/rePassword.css">
    <title>Reset Password</title>
</head>
<body>
    <div class="modal">
      <h1>Reset Password</h1>
      <p class="subtitle">Choose a new password for your account.</p>
 
      <!--
        NOTE: :token needs to be replaced with the real reset token,
        e.g. server-templated (EJS/Handlebars) or set from the URL via JS
        before this form is shown.
 
        Browsers only submit forms natively as GET or POST, so this uses
        method="POST" + a hidden _method=PUT field (the standard
        method-override pattern, e.g. Express + method-override middleware).
        Swap this out if your backend doesn't use that convention.
      -->
      <form id="resetForm" novalidate action="/resetPass" method="POST">
        <!-- <input type="hidden" name="_method" value="PUT"> -->
 
        <div class="field" id="passwordField">
          <label for="password">New Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter new password"
              autocomplete="new-password"
            >
            <button type="button" class="toggle-pass" data-target="password" aria-label="Show password">
              <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a21.8 21.8 0 0 1 5.06-6.06M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 7 11 7a21.8 21.8 0 0 1-4 5.19M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
          <p class="error-msg">Almost there — your password still needs a few things below.</p>
 
          <ul class="requirements" id="requirements">
            <li id="req-length">
              <span class="req-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              At least 8 characters
            </li>
            <li id="req-upper">
              <span class="req-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              Include uppercase letters (A-Z)
            </li>
            <li id="req-lower">
              <span class="req-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              Include lowercase letters (a-z)
            </li>
            <li id="req-number">
              <span class="req-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              Include numbers (0-9)
            </li>
            <li id="req-special">
              <span class="req-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              Include special characters (!@#$%^&*...)
            </li>
          </ul>
        </div>
 
        <button type="submit" class="update-btn" id="updateBtn">Update Password</button>
 
        <p class="auth-status" id="authStatus"></p>
 
        <a href="/login" class="return-link" id="returnLink">&larr; Back to login</a>
      </form>
    </div>
    <script src="js/user/rePassword.js"></script>
</body>
</html>