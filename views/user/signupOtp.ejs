     <div class="modal">
      <h1>Verify Code</h1>
      <p class="subtitle">Enter the 6-digit code we sent to your email to continue resetting your password.</p>
 
      <form id="otpForm" novalidate action="/verify-otp" method="post">
 
        <div class="field" id="otpField">
          <label for="otpBox0">Enter OTP</label>
 
          <div class="otp-input-wrap">
            <input type="text" class="otp-box" id="otpBox0" inputmode="numeric" name="otp1" maxlength="1" autocomplete="one-time-code">
            <input type="text" class="otp-box" id="otpBox1" inputmode="numeric" name="otp2" maxlength="1">
            <input type="text" class="otp-box" id="otpBox2" inputmode="numeric" name="otp3" maxlength="1">
            <input type="text" class="otp-box" id="otpBox3" inputmode="numeric" name="otp4" maxlength="1">
            <input type="text" class="otp-box" id="otpBox4" inputmode="numeric" name="otp5" maxlength="1">
            <input type="text" class="otp-box" id="otpBox5" inputmode="numeric" name="otp6" maxlength="1">
          </div>
 
          <!-- Hidden field carrying the combined 6-digit value submitted to the server -->
          <input type="hidden" name="otp" id="otpHidden">
 
          <p class="otp-timer" id="timerText">Code expires in <span id="timerValue">01:00</span></p>
          <p class="error-msg">Please enter the 6-digit code sent to your email.</p>
        </div>
 
        <button type="submit" class="recovery-btn" id="verifyBtn">Verify Code</button>
 
        <p class="auth-status" id="authStatus"></p>
 
        
      </form>
      <div class="resend-wrap">
          Didn't get the code?
          <form action="/signup/resendOtp" method="POST" >
            <button type="submit" id="resendLink" class="resend-link">
                Resend code
            </button>
        </form>
      </div>
      
        <hr class="divider-line">
 
        <a href="/login" class="back-link">&lt; Back to Login</a>
    </div>

    <div id="toast" class="toast"></div>
    <script src="/js/user/signupOtp.js"></script>
  </body>
