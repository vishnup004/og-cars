<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>forget</title>
    <link rel="stylesheet" href="/css/user/forgetPass.css">
</head>
<body>
    <div class="modal">
      <h1>Forgot Password?</h1>
      <p class="subtitle">Enter your registered email address and we'll send you a recovery code to reset your password.</p>

      <form id="forgotForm" novalidate action="/verify-email" method="post">

        <div class="field" id="emailField">
          <label for="email">Email</label>
          <div class="input-wrap">
            <input
              type="text"
              id="email"
              name="email"
              placeholder="Enter your email"
              autocomplete="email"
            />
          </div>
          <p class="error-msg">Please enter a valid email address.</p>
        </div>

        <!-- <div class="field" id="otpField" style="display:none;">
          <label for="otp">Enter OTP</label>
          <div class="input-wrap">
            <input
              type="text"
              id="otp"
              name="otp"
              placeholder="Enter 6-digit code"
              autocomplete="one-time-code"
              inputmode="numeric"
              maxlength="6"
            />
          </div>
          <p class="otp-timer" id="otpTimer">Code expires in <span id="otpTimeLeft">05:00</span></p>
          <p class="error-msg">Please enter the 6-digit code sent to your email.</p>
        </div> -->

        <button type="submit" class="recovery-btn" id="recoveryBtn">Send Recovery Code</button>

        <p class="auth-status" id="authStatus"></p>

        <p class="resend-wrap" id="resendWrap">
          Didn't get the code?
          <button type="submit" name="resend" value="true" class="resend-link" id="resendBtn">Resend OTP</button>
        </p>

        <hr class="divider-line">

        <a href="/login" class="back-link">&lt; Back to Login</a>
      </form>
    </div>

    <script src="/js/user/forgetPass.js"></script>
</body>
</html>