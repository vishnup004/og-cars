<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Address</title>

    <link rel="stylesheet" href="/css/user/profile.css">
    <link rel="stylesheet" href="/css/user/address.css">
</head>

 <body>

<div class="dashboard">

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <a href="/home" class="back-link">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            BACK TO DASHBOARD
        </a>

        <nav class="side-nav">

            <a href="/profile" class="nav-item" data-panel="profile">
                <span class="nav-bar"></span>

                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
                </svg>

                USER PROFILE
            </a>


            <a href="/change-password" class="nav-item" data-panel="password">
                <span class="nav-bar"></span>

                <svg viewBox="0 0 24 24">
                    <circle cx="8" cy="15" r="4"/>
                    <path d="M10.5 12.5L20 3M20 3v5M20 3h-5"/>
                </svg>

                CHANGE PASSWORD
            </a>


            <a href="/profile/address" class="nav-item active" data-panel="address">

                <span class="nav-bar"></span>

                <svg viewBox="0 0 24 24">
                    <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/>
                    <circle cx="12" cy="10" r="2.5"/>
                </svg>

                USER ADDRESS

            </a>


            <a href="/profile/orders" class="nav-item" data-panel="orders">

                <span class="nav-bar"></span>

                <svg viewBox="0 0 24 24">
                    <rect x="3" y="7" width="18" height="14" rx="2"/>
                    <path d="M8 7V5a4 4 0 0 1 8 0v2"/>
                </svg>

                VIEW ORDERS

            </a>


            <a href="/user/wishlist" class="nav-item" data-panel="watchlist">

                <span class="nav-bar nav-bar-pink"></span>

                <svg viewBox="0 0 24 24">
                    <path d="M12 21s-7.5-4.9-10-9.3C.4 8.3 2 4.5 5.7 4c2-.3 3.9.7 6.3 3.2C14.4 4.7 16.3 3.7 18.3 4c3.7.5 5.3 4.3 3.7 7.7C19.5 16.1 12 21 12 21z"/>
                </svg>

                WATCHLIST

            </a>


            <a href="/profile/wallet" class="nav-item" data-panel="wallet">

                <svg viewBox="0 0 24 24">
                    <rect x="2" y="6" width="20" height="14" rx="2"/>
                    <path d="M2 10h20M17 15h1"/>
                </svg>

                WALLET

            </a>


            <a href="#" class="nav-item" id="logoutBtn" data-panel="logout">

                <svg viewBox="0 0 24 24">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <path d="M16 17l5-5-5-5"/>
                    <path d="M21 12H9"/>
                </svg>

                LOGOUT

            </a>

        </nav>

    </aside>


    <!-- =====================================================
         MAIN PANEL
    ====================================================== -->

    <main class="panel">


        <!-- HEADER -->

        <div class="address-panel-header">

            <h1 class="panel-title">
                MY ADDRESSES
            </h1>

            <button
                type="button"
                class="btn-add-address"
                id="addAddressBtn">

                <svg viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14"/>
                </svg>

                ADD NEW ADDRESS

            </button>

        </div>


        <div class="panel-divider"></div>



        <!-- =================================================
             ADDRESS LIST

             IMPORTANT:
             address-list stays OPEN while forEach runs.
             ================================================= -->

        <div class="address-list">

            <% addresses.forEach(address => { %>


                <!-- =================================================
                     ADDRESS CARD
                ================================================= -->

                <div
                    class="address-card <%= address.isDefault ? 'is-default' : '' %>"

                    data-address-id="<%= address._id %>"

                    data-name="<%= address.name %>"

                    data-phone-number="<%= address.phoneNumber %>"

                    data-address-line="<%= address.addressLine %>"

                    data-district="<%= address.district %>"

                    data-city="<%= address.city %>"

                    data-state="<%= address.state %>"

                    data-pincode="<%= address.pincode %>"

                    data-label="<%= address.label %>"
                >


                    <!-- =================================================
                         LEFT SIDE
                    ================================================== -->

                    <div class="address-card-main">


                        <!-- DEFAULT STATUS -->

                        <div class="address-status-row">

                            <% if (address.isDefault) { %>

                                <span class="default-badge">

                                    <svg viewBox="0 0 24 24">
                                        <path d="M20 6L9 17l-5-5"/>
                                    </svg>

                                    DEFAULT ADDRESS

                                </span>

                            <% } else { %>

                                <button
                                    type="button"
                                    class="set-default-btn"
                                    data-set-default="<%= address._id %>"
                                >

                                    <svg viewBox="0 0 24 24">
                                        <circle
                                            cx="12"
                                            cy="12"
                                            r="9"
                                        />
                                    </svg>

                                    SET AS DEFAULT

                                </button>

                            <% } %>

                        </div>



                        <!-- NAME -->

                        <p class="address-name">
                            <%= address.name %>
                        </p>



                        <!-- ADDRESS -->

                        <div class="address-lines">

                            <svg viewBox="0 0 24 24">
                                <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/>
                                <circle cx="12" cy="10" r="2.5"/>
                            </svg>


                            <span>

                                <%= address.addressLine %>
                                <br>

                                <%= address.city %>,
                                <%= address.state %> -
                                <%= address.pincode %>

                            </span>

                        </div>

                    </div>



                    <!-- =================================================
                         RIGHT SIDE
                    ================================================== -->

                    <div class="address-card-side">


                        <!-- LABEL -->

                        <span class="address-tag">

                            <svg viewBox="0 0 24 24">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 0 2-2z"/>
                            </svg>

                            <%= address.label %>

                        </span>



                        <!-- PHONE -->

                        <div class="address-contact-block">

                            <div class="address-phone">

                                <svg viewBox="0 0 24 24">

                                    <path
                                        d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.9.6 2.7a2 2 0 0 1-.4 2.1L8 9.9a16 16 0 0 0 6 6l1.4-1.4a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.8 2z"
                                    />

                                </svg>

                                <%= address.phoneNumber %>

                            </div>


                            <div class="address-country">
                                INDIA
                            </div>

                        </div>



                        <!-- ACTION BUTTONS -->

                        <div class="address-actions">


                            <!-- EDIT -->

                            <button
                                type="button"
                                class="address-action-btn edit"
                                data-edit-address="<%= address._id %>"
                                aria-label="Edit address"
                            >

                                <svg viewBox="0 0 24 24">

                                    <path
                                        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                                    />

                                    <path
                                        d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z"
                                    />

                                </svg>

                            </button>



                            <!-- DELETE -->

                            <button
                                type="button"
                                class="address-action-btn delete"
                                data-delete-address="<%= address._id %>"
                                aria-label="Delete address"
                            >

                                <svg viewBox="0 0 24 24">

                                    <path d="M3 6h18"/>

                                    <path
                                        d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                    />

                                    <path
                                        d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"
                                    />

                                </svg>

                            </button>


                        </div>

                    </div>

                </div>
                <!-- END ADDRESS CARD -->


            <% }) %>

        </div>
        <!-- END ADDRESS LIST -->



        <!-- =================================================
             EMPTY STATE
        ================================================== -->

        <!--
        <div class="address-empty">

            <svg viewBox="0 0 24 24">
                <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/>
                <circle cx="12" cy="10" r="2.5"/>
            </svg>

            <p>
                NO ADDRESSES SAVED YET
            </p>

            <span>
                Add a delivery address to speed up checkout.
            </span>

        </div>
        -->


    </main>

</div>



<!-- =========================================================
     ADD / EDIT ADDRESS MODAL
========================================================== -->

<div
    class="modal-overlay"
    id="addressModalOverlay"
>

    <div
        class="modal-box"
        role="dialog"
        aria-modal="true"
        aria-labelledby="addressModalTitle"
    >


        <!-- HEADER -->

        <div class="modal-header">

            <h2 id="addressModalTitle">
                ADD NEW ADDRESS
            </h2>


            <button
                type="button"
                class="modal-close"
                id="addressModalCloseBtn"
                aria-label="Close"
            >

                <svg viewBox="0 0 24 24">
                    <path d="M18 6L6 18M6 6l12 12"/>
                </svg>

            </button>

        </div>



        <!-- FORM -->

        <form
            class="modal-form"
            id="addressForm"
            action="/add/address"
            method="POST"
        >


            <!-- ADDRESS ID -->

            <input
                type="hidden"
                name="addressId"
                id="addressId"
                value=""
            >



            <!-- FULL NAME -->

            <div class="field-group">

                <label for="addrFullName">
                    FULL NAME
                </label>

                <input
                    type="text"
                    id="addrFullName"
                    name="name"
                >

            </div>



            <!-- PHONE -->

            <div class="field-group">

                <label for="addrPhone">
                    PHONE NUMBER
                </label>

                <div class="phone-input">

                    <span class="phone-code">
                        +91
                    </span>

                    <input
                        type="tel"
                        id="addrPhone"
                        name="phone"
                    >

                </div>

            </div>



            <!-- ADDRESS LINE -->

            <div class="field-group">

                <label for="addrLine1">
                    ADDRESS LINE
                </label>

                <input
                    type="text"
                    id="addrLine1"
                    name="addressLine"
                    placeholder="House / building, street"
                >

            </div>



            <!-- DISTRICT -->

            <div class="field-group">

                <label for="district">
                    DISTRICT
                </label>

                <input
                    type="text"
                    id="district"
                    name="district"
                >

            </div>



            <!-- CITY + STATE -->

            <div class="field-row">


                <div class="field-group">

                    <label for="addrCity">
                        CITY
                    </label>

                    <input
                        type="text"
                        id="addrCity"
                        name="city"
                    >

                </div>


                <div class="field-group">

                    <label for="addrState">
                        STATE
                    </label>

                    <input
                        type="text"
                        id="addrState"
                        name="state"
                    >

                </div>


            </div>



            <!-- PINCODE + LABEL -->

            <div class="field-row">


                <div class="field-group">

                    <label for="addrPincode">
                        PINCODE
                    </label>

                    <input
                        type="text"
                        id="addrPincode"
                        name="pincode"
                        maxlength="6"
                    >

                </div>

                <div class="field-group">

                    <label for="addrLabel">
                        LABEL
                    </label>

                    <input
                        type="text"
                        id="addrLabel"
                        name="label"
                        placeholder="Home / Work"
                    >
                </div>
            </div>
            <!-- ERROR -->
            <p
                class="modal-error"
                id="addressModalError"
            ></p>

            <!-- BUTTONS -->
            <div class="modal-actions">
                <button
                    type="button"
                    class="btn-cancel"
                    id="addressModalCancelBtn"
                >
                    CANCEL
                </button>
                <button
                    type="submit"
                    class="btn-save"
                >
                    SAVE ADDRESS
                </button>
            </div>
        </form>
    </div>
</div>



<!-- =========================================================
     DELETE CONFIRM MODAL
========================================================== -->

<div
    class="modal-overlay"
    id="deleteModalOverlay"
>

    <div
        class="modal-box modal-danger"
        role="dialog"
        aria-modal="true"
        aria-labelledby="deleteModalTitle"
    >
        <!-- HEADER -->

        <div class="modal-header">

            <h2 id="deleteModalTitle">
                DELETE ADDRESS
            </h2>


            <button
                type="button"
                class="modal-close"
                id="deleteModalCloseBtn"
                aria-label="Close"
            >

                <svg viewBox="0 0 24 24">
                    <path d="M18 6L6 18M6 6l12 12"/>
                </svg>

            </button>

        </div>



        <p class="modal-danger-text">

            This address will be permanently removed from your account.
            This action can't be undone.

        </p>



        <form
            id="deleteAddressForm"
            action="/address/delete?_method=DELETE"
            method="POST"
        >

            <input
                type="hidden"
                name="addressId"
                id="deleteAddressId"
                value=""
            >


            <div class="modal-actions">

                <button
                    type="button"
                    class="btn-cancel"
                    id="deleteModalCancelBtn"
                >
                    CANCEL
                </button>


                <button
                    type="submit"
                    class="btn-save btn-delete-confirm"
                >
                    DELETE
                </button>

            </div>

        </form>

    </div>

</div>
<div id="toast" class="toast">
    <span class="toast-icon">✓</span>
    <span>Password changed successfully!</span>
</div>

<!-- =========================================================
     LOGOUT CONFIRM MODAL
========================================================== -->

<div class="modal-overlay" id="logoutModalOverlay">
    <div class="modal-box modal-danger" role="dialog" aria-modal="true" aria-labelledby="logoutModalTitle">
        <!-- HEADER -->
        <div class="modal-header">
            <h2 id="logoutModalTitle">
                LOGOUT
            </h2>
            <button type="button" class="modal-close" id="logoutModalCloseBtn" aria-label="Close">
                <svg viewBox="0 0 24 24">
                    <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <!-- MESSAGE -->
        <p class="modal-danger-text">
            Are you sure you want to logout from your account?
        </p>
        <!-- LOGOUT FORM -->
        <form id="logoutForm" action="/logout" method="POST">
            <div class="modal-actions">
                <button type="button" class="btn-cancel" id="logoutModalCancelBtn">
                    CANCEL
                </button>
                <button
                    type="submit"
                    class="btn-save btn-delete-confirm">
                    LOGOUT
                </button>
            </div>
        </form>
    </div>
</div>

<script src="/js/user/address.js"></script>

</body>
</html>