                        <input type="radio" name="priceRangePreset" value="0-1000"> Under ₹1,000
                      </label>
                      <label class="filter-option">
                        <input type="radio" name="priceRangePreset" value="1000-5000"> ₹1,000 – ₹5,000
                      </label>
