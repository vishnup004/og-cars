<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/admin/category.css">
    <title>Document</title>
</head>
<body>
    
  <div class="shell">
 
    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <h1>OG_CARS Admin</h1>
        <p>CONTROL PANEL</p>
      </div>
 
      <nav class="nav">
        <a href="/admin/home" class="nav-link" data-view="dashboard">
        <span class="nav-icon"></span> Dashboard
      </a>
      <a href="/admin/product" class="nav-link" data-view="products">
        <span class="nav-icon"></span> Products
      </a>
      <a href="/admin/category" class="nav-link" data-view="categories">
        <span class="nav-icon"></span> Categories
      </a>
      <a href="/admin/orders" class="nav-link" data-view="orders">
        <span class="nav-icon"></span> Orders
      </a>
      <a href="/admin/user" class="nav-link" data-view="users">
        <span class="nav-icon"></span> Users
      </a>
      <a href="/admin/offer" class="nav-link" data-view="offer">
        <span class="nav-icon"></span> Offer
      </a>
      <a href="/admin/coupons" class="nav-link" data-view="coupons">
        <span class="nav-icon"></span> Coupons
      </a>
      <a href="/admin/profile" class="nav-link" data-view="profile">
        <span class="nav-icon"></span> Profile
      </a>  
      </nav>
 
      <div class="nav-bottom">
        <a href="/admin/settings" class="nav-link">
          <span class="nav-icon">⚙️</span> Settings
        </a>
        <a href="/admin/logout" class="nav-link nav-link-danger">
          <span class="nav-icon">🚪</span> Logout
        </a>
      </div>
    </aside>
 
    <!-- ===== MAIN ===== -->
    <div class="main">
      <header class="topbar">
        <button class="menu-btn" id="menuBtn">☰</button>
        <h2>Categories</h2>
      </header>
 
      <main class="content">
        <div class="page-intro">
          <p>Create, list/unlist, and manage the product categories shown in your storefront.</p>
          <button class="add-category-btn" id="openAddModalBtn">
            <span>+</span> Add Category
          </button>
        </div>
 
        <div class="panel">
          <div class="panel-header">
            <h3>All Categories</h3>
 
            <div class="panel-header-actions">
              <form class="toolbar" id="searchForm" method="GET" action="/admin/categories">
                <div class="search-wrap">
                  <span class="search-icon">🔍</span>
                  <input
                    type="text"
                    class="search-input"
                    id="searchInput"
                    name="search"
                    placeholder="Search categories..."
                    value=""
                  >
                  <button type="button" class="clear-btn" id="clearSearchBtn" title="Clear search">✕</button>
                </div>
 
                <input type="hidden" id="pageInput" name="page" value="1">
                <input type="hidden" id="minPriceInput" name="minPrice" value="">
                <input type="hidden" id="maxPriceInput" name="maxPrice" value="">
                <input type="hidden" id="brandInput" name="brand" value="">
 
                <button type="button" class="search-submit-btn" id="searchSubmitBtn">Search</button>
 
                <!-- <div class="filter-wrap">
                  <button type="button" class="filter-btn" id="filterToggleBtn">
                    Filter
                    <span class="filter-count" id="filterCount" style="display:none;">0</span>
                  </button>
 
                  <div class="filter-panel" id="filterPanel">
                    <div class="filter-section" id="priceRangeGroup">
                      <span class="filter-section-title">Price Range</span>
                      <div class="filter-price-inputs">
                        <input type="number" id="fMinPrice" placeholder="Min">
                        <span class="filter-price-sep">–</span>
                        <input type="number" id="fMaxPrice" placeholder="Max">
                      </div>
