                        <input type="radio" name="priceRangePreset" value="5000-10000"> ₹5,000 – ₹10,000
                      </label>
                      <label class="filter-option">
                        <input type="radio" name="priceRangePreset" value="10000-"> ₹10,000+
                      </label>
                    </div>
 
                    <div class="filter-section" id="brandGroup">
                      <span class="filter-section-title">Brand</span>
                      <div class="filter-checkbox-group">
                        <label class="filter-option">
                          <input type="checkbox" name="fBrand" value="Traxxas"> Traxxas
                        </label>
                        <label class="filter-option">
                          <input type="checkbox" name="fBrand" value="Tamiya"> Tamiya
                        </label>
                        <label class="filter-option">
                          <input type="checkbox" name="fBrand" value="HPI Racing"> HPI Racing
                        </label>
                        <label class="filter-option">
                          <input type="checkbox" name="fBrand" value="Losi"> Losi
                        </label>
                        <label class="filter-option">
                          <input type="checkbox" name="fBrand" value="Arrma"> Arrma
                        </label>
                      </div>
                    </div>
 
                    <div class="filter-panel-actions">
                      <button type="button" class="modal-btn modal-btn-cancel" id="filterClearBtn">Clear</button>
                      <button type="button" class="modal-btn modal-btn-save" id="filterApplyBtn">Apply</button>
                    </div>
                  </div>
                </div> -->
              </form>
            </div>
          </div>
 
          <!-- Active filter chips (populated client-side from the URL on load) -->
          <div class="active-filter-chips" id="activeFilterChips"></div>
 
          <!-- ===== CATEGORY LIST (sample rows) ===== -->
           <div class="category-list" id="categoryList">
           <% category.forEach(cat => { %>
 
            <div class="category-row">
              <div class="cat-cell">
                <img class="cat-thumb" src="<%= cat.image%>" alt="Off-Road Buggies">
                <div>
                  <span class="cat-name"><%= cat.name%></span>
                  <span class="cell-desc"><%= cat.discription%></span>
                </div>
              </div>
 
              <div class="row-products">
                <span class="row-products-label">Products</span>
                <span class="row-products-count"></span>
              </div>
 
              <span class="status-badge <%= cat.status === 'active' ? 'active' : 'blocked' %>" data-status-id="<%= cat._id%>">
                <%= cat.status === 'active' ? 'Listed' : 'Unlisted'%>
              </span>
 
              <div class="actions-cell">
                <button
                  class="icon-btn edit-btn"
                  title="Edit"
                  data-id="<%= cat._id%>"
                  data-name="<%= cat.name%>"
                  data-description="<%= cat.discription%>"
                  data-image="<%= cat.image%>"
                >✏️</button>
 
                <button class="icon-btn delete-btn" title="Delete" data-id="<%= cat._id%>" data-name="<%= cat.name%>">🗑️</button>

                <% if(cat.status === 'active') { %>
 
                <button class="block-btn" title="Unlist category" data-id="<%= cat._id %>"></button>
                <%} else {%>
                  <button class="unblock-btn" title="List category" data-id="<%= cat._id %>"></button>
                <% } %>
              </div>
            </div>

          <% }) %>
          </div>
 
          <!-- ===== PAGINATION (sample) ===== -->
          <div class="pagination-bar">
            <span class="pagination-info">Page <%= currentPage%> of <%= totalPage%></span>
            <div class="pagination-controls">
              <a class="page-btn disabled" href="/admin/category?search=&page=<%= currentPage > 1 ? currentPage - 1 : currentPage %>" aria-disabled="true">‹</a>
              <% for(let i = 1 ; i < totalPage ; i++ ) { %>
                <a class="page-btn active" href="/admin/category?search=&page=<%= i%>"><%= i%></a>
                <% } %>
              
              
              <a class="page-btn" href="/admin/category?search=&page=<%= totalPage > currentPage ? currentPage + 1 : currentPage%>">›</a>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
 
  <!-- ===== ADD / EDIT MODAL ===== -->
  <div class="modal-overlay" id="categoryModalOverlay">
    <div class="modal">
      <div class="modal-header">
        <h3 id="modalTitle">Add Category</h3>
        <button class="modal-close-btn" id="closeModalBtn">✕</button>
      </div>
 
      <form class="modal-form" id="categoryForm" enctype="multipart/form-data">
        <input type="hidden" id="categoryId" name="categoryId" value="">
 
        <div class="form-group">
          <label for="categoryName">Name</label>
          <input type="text" id="categoryName" name="categoryName" placeholder="e.g. Off-Road Buggies">
          <span class="field-error" id="nameError"></span>
        </div>
 
        <div class="form-group">
          <label for="categoryDescription">Description</label>
          <textarea id="categoryDescription" name="categoryDescription" rows="3" placeholder="Short description (optional)"></textarea>
          <span class="field-error" id="descriptionError"></span>
        </div>
 
        <div class="form-group">
          <label for="categoryImage">Image</label>
          <div class="image-upload-wrap">
            <img class="image-preview" id="imagePreview" src="" alt="" style="display:none;">
            <label class="image-upload-btn" for="categoryImage">Choose Image</label>
            <input type="file" id="categoryImage" name="categoryImage" accept="image/*">
          </div>
          <span class="field-error" id="imageError"></span>
        </div>
 
        <div class="modal-actions">
          <button type="button" class="modal-btn modal-btn-cancel" id="cancelModalBtn">Cancel</button>
          <button type="submit" class="modal-btn modal-btn-save" id="saveCategoryBtn">Save Category</button>
        </div>
      </form>
    </div>
  </div>


<div class="modal-overlay" id="deleteModalOverlay">
  <div class="modal">
    <div class="modal-header">
      <h3>Delete Category</h3>

      <button
        class="modal-close-btn"
        id="closeDeleteModalBtn"
        type="button">✕</button>
    </div>

    <div class="modal-form">
      <p>
        Are you sure you want to delete this category?</p>
      <p id="deleteCategoryName"></p>

      <input
        type="hidden"
        id="deleteCategoryId">

      <div class="modal-actions">

        <button
          type="button"
          class="modal-btn modal-btn-cancel"
          id="cancelDeleteBtn">  Cancel</button>

        <button
          type="button"
          class="modal-btn modal-btn-save"
          id="confirmDeleteBtn">Delete</button>
      </div>
    </div>
  </div>
</div>
 
  <!-- ===== TOAST ===== -->
  <div class="toast" id="toast"></div>
 
<script src="/js/admin/category.js"></script>
</body>
</html>
