            <!-- Active filter chips (populated client-side from the URL on load) -->
            <div class="active-filter-chips" id="activeFilterChips"></div>
  
            <!-- ===== PRODUCT LIST (sample rows — replace with real data,
                e.g. by having product-admin.js fetch and render on load) ===== -->

            <% if (products) { %>
              <% products.forEach( product => {%>
            <div class="category-list" id="categoryList">

              <div class="category-row">
                <div class="cat-cell">
                  <img class="cat-thumb" src="<%= product.images[0]%>" alt="">
                  <div>
                    <span class="cat-name"><%= product.productName%></span>
                    <span class="cell-desc"><%= product.discription%></span>
                  </div>
                </div>
  
                <div class="row-products">
                  <span class="row-products-label">Price</span>
                  <span class="row-products-count"><%= product.price%></span>
                </div>

                <div class="row-products">
                  <span class="row-products-label">Stock</span>
                  <span class="row-products-count"><%= product.variant?.reduce((total, item) => total + Number(item.stock || 0), 0) || 0 %></span>
                </div>
  
                <span class="status-badge active" data-status-id="<%= product._id %>">
                  <%= product.status ? "list" : "unlist" %>
                </span>
  
                <div class="actions-cell">
                  <button
                    class="icon-btn edit-btn"
                    title="Edit"
                    data-id="<%= product._id%>"
                    data-name="<%= product.productName%>"
                    data-description="<%= product.discription%>"
                    data-image="<%= product.images[0] ? product.images[0] : '' %>"
                    data-image2="<%= product.images[1] ? product.images[1] : '' %>"
                    data-image3="<%= product.images[2] ? product.images[2] : '' %>"
                   
                    data-category="<%= product.category %>"
                    data-price="<%= product.price %>"
                    data-stock="<%= product.stock %>"
                    data-color="<%= product.colores %>"
                    data-motor="<%= product.motorType %>"
                    data-chassis="<%= product.chassisMaterial %>"
                    data-scale="<%= product.scale %>"
                  >✏️</button>
  
                  <button class="icon-btn delete-btn" title="Delete" data-id="<%= product._id %>" data-name="<%= product.name %>">🗑️</button>

                  <button class="block-btn" title="Unlist product" data-id="<%= product._id%>"></button>
                </div>
              </div>
            </div>
            <% }) %>
            <% } %>
  
            <!-- ===== PAGINATION (sample) ===== -->
            <div class="pagination-bar">
              <span class="pagination-info"></span>
              <div class="pagination-controls">
                
                <a class="page-btn <%= currentPage === 1 ? 'disabled' : '' %>" href="/admin/product?search=&page=<%= currentPage > 1 ? currentPage - 1 : currentPage %>" aria-disabled="true">‹</a>
                
                <% for(let i = 1; i <=  totalPages; i++) { %>
                  <a class="page-btn <%= i === currentPage === i ? 'active' : '' %>" href="/admin/product?search=&page=<%= i%>"><%= i%></a>
                  <% } %>
                  
                <a class="page-btn <%= currentPage === totalPages ? 'disabled' : '' %>" href="/admin/product?search=&page=<%= totalPages > currentPage ? currentPage + 1 : currentPage %>">›</a>
              </div>
            </div>
