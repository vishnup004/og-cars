    <!-- ===== TOAST ===== -->
    <div class="toast" id="toast"></div>
    <div id="cropModal" class="crop-modal">

    <div class="crop-modal-content">

      <div class="crop-modal-header">
        <h3>Crop Product Image</h3>

        <button
          type="button"
          id="closeCropModal"
          class="crop-close-btn"
        >
          ×
        </button>
      </div>


      <div class="crop-container">
        <img id="cropImage" src="" alt="Crop Image">
      </div>


      <div class="crop-controls">

        <button type="button" id="zoomOutBtn">
          −
        </button>

        <span id="zoomValue">
          100%
        </span>

        <button type="button" id="zoomInBtn">
          +
        </button>

        <button type="button" id="rotateLeftBtn">
          ↶
        </button>

        <button type="button" id="rotateRightBtn">
          ↷
        </button>

        <button type="button" id="resetCropBtn">
          Reset
        </button>

      </div>


      <div class="crop-actions">

        <button
          type="button"
          id="cancelCropBtn"
          class="cancel-crop-btn"
        >
          Cancel
        </button>

        <button
          type="button"
          id="applyCropBtn"
          class="apply-crop-btn"
        >
          Crop & Resize
        </button>

      </div>

    </div>

