          <!-- ===== TECHNICAL VARIANTS ===== -->
          <div class="form-section">
            <span class="form-section-title">Technical Variants</span>
            <div class="form-group-row">
            <div class="form-group">
              <label for="colorInput">Colors</label>
              <div class="color-input-row">
                <input type="text" id="colorInput" placeholder="e.g. Red">
                <button type="button" class="modal-btn modal-btn-save" id="addColorBtn">Add</button>
              </div>
              <div class="color-tags" id="colorTags"></div>
              <input type="hidden" id="productColors" name="productColors" value="">
              <span class="field-error" id="colorError"></span>
            </div>
          </div>
          </div>

          <!-- ===== TECHNICAL SPECIFICATION ===== -->
          <div class="form-section">
            <span class="form-section-title">Technical Specification</span>
            <div class="form-group">
              <label for="productMotorType">Motor Type</label>
              <input type="text" id="productMotorType" name="productMotorType" placeholder="e.g. Brushless 3300KV">
              <span class="field-error" id="motorError"></span>
            </div>
            <div class="form-group-row">
              <div class="form-group">
                <label for="productChassisMaterial">Chassis Material</label>
                <input type="text" id="productChassisMaterial" name="productChassisMaterial" placeholder="e.g. Aluminum">
                <span class="field-error" id="chassisError"></span>
              </div>
              <div class="form-group">
                <label for="productScale">Scale</label>
                <select id="productScale" name="productScale">
                  <option value="">Select scale</option>
                  <option value="1:8">1:8</option>
                  <option value="1:10">1:10</option>
                  <option value="1:12">1:12</option>
                  <option value="1:16">1:16</option>
                  <option value="1:24">1:24</option>
                  <option value="other">Other</option>
                </select>
                <span class="field-error" id="scaleError"></span>
              </div>
            </div>
          </div>
  
          <div class="modal-actions">
            <button type="button" class="modal-btn modal-btn-cancel" id="cancelModalBtn">Cancel</button>
            <button type="submit" class="modal-btn modal-btn-save" id="saveCategoryBtn">Save Product</button>
